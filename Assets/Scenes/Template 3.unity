          m_IntArgument: 0
          m_FloatArgument: 0
          m_StringArgument: "\u042D\u043D\u0435\u0440\u0433\u043E\u044F\u0434\u0440\u043E
            \u0441\u043F\u043E\u0441\u043E\u0431\u043D\u043E \u0433\u0435\u043D\u0435\u0440\u0438\u0440\u043E\u0432\u0430\u0442\u044C
