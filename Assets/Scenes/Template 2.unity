        m_Arguments:
          m_ObjectArgument: {fileID: 0}
          m_ObjectArgumentAssemblyTypeName: UnityEngine.Object, UnityEngine
          m_IntArgument: 0
          m_FloatArgument: 0
          m_StringArgument: "\u042D\u043D\u0435\u0440\u0433\u043E\u044F\u0434\u0440\u043E
            \u0441\u043F\u043E\u0441\u043E\u0431\u043D\u043E \u0433\u0435\u043D\u0435\u0440\u0438\u0440\u043E\u0432\u0430\u0442\u044C
            \u043D\u0430\u043F\u0440\u0430\u0432\u043B\u0435\u043D\u043D\u044B\u0439
            \u0438\u043C\u043F\u0443\u043B\u044C\u0441 \u043F\u0440\u0438 \u043A\u043E\u043D\u0442\u0430\u043A\u0442\u0435
            \u0441 \u043B\u044E\u0431\u043E\u0439 \u0443\u0441\u0442\u043E\u0439\u0447\u0438\u0432\u043E\u0439
            \u043F\u043E\u0432\u0435\u0440\u0445\u043D\u043E\u0441\u0442\u044C\u044E.
            \u041D\u0435\u0437\u0430\u0432\u0438\u0441\u0438\u043C\u043E \u043E\u0442
            \u043E\u0440\u0438\u0435\u043D\u0442\u0430\u0446\u0438\u0438 \u0432 \u043F\u0440\u043E\u0441\u0442\u0440\u0430\u043D\u0441\u0442\u0432\u0435,
            \u0432\u0435\u043A\u0442\u043E\u0440 \u0441\u0438\u043B\u044B \u0432\u0441\u0435\u0433\u0434\u0430
            \u0434\u0435\u0439\u0441\u0442\u0432\u0443\u0435\u0442 \u043F\u0440\u043E\u0442\u0438\u0432
            \u043B\u043E\u043A\u0430\u043B\u044C\u043D\u043E\u0439 \u0433\u0440\u0430\u0432\u0438\u0442\u0430\u0446\u0438\u0438
            - \u0438\u043B\u0438, \u0435\u0441\u043B\u0438 \u0432\u044B\u0440\u0430\u0437\u0438\u0442\u044C\u0441\u044F
            \u043F\u0440\u043E\u0449\u0435: \u043D\u0430\u0436\u0430\u0442\u0438\u0435
            \u043A\u043D\u043E\u043F\u043A\u0438 \u0430\u043A\u0442\u0438\u0432\u0430\u0446\u0438\u0438
            \u0432\u0441\u0435\u0433\u0434\u0430 \u0434\u0430\u0441\u0442 \u0442\u043E\u043B\u0447\u043E\u043A
            \u0432\u0432\u0435\u0440\u0445, \u043A\u0443\u0434\u0430 \u0431\u044B
            \u044D\u0442\u043E '\u0432\u0432\u0435\u0440\u0445' \u0432 \u0434\u0430\u043D\u043D\u044B\u0439
            \u043C\u043E\u043C\u0435\u043D\u0442 \u043D\u0438 \u0431\u044B\u043B\u043E
            \u043D\u0430\u043F\u0440\u0430\u0432\u043B\u0435\u043D\u043E. \u041F\u043E\u043B\u0435\u0437\u043D\u043E\u0435
            \u0441\u0432\u043E\u0439\u0441\u0442\u0432\u043E \u0432 \u0443\u0441\u043B\u043E\u0432\u0438\u044F\u0445...
            \u0438\u0437\u043C\u0435\u043D\u0447\u0438\u0432\u043E\u0439 \u0444\u0438\u0437\u0438\u0447\u0435\u0441\u043A\u043E\u0439
            \u0441\u0440\u0435\u0434\u044B."
